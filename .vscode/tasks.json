{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Scan WeCreat KB",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "wecreat_index"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Open web UI",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "wecreat_index.server"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Scan WeCreat KB (dry run)",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "wecreat_index",
        "--dry-run",
        "--verbose"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Build distributable (.pyz + zip)",
      "type": "shell",
      "command": "python",
      "args": [
        "build.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
